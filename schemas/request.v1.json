{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "toxiply.analysis.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "content": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "categories": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "toxicity",
          "harassment",
          "hate",
          "threat",
          "sexual_risk",
          "profanity",
          "spam_scam"
        ]
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "parentText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "quotedText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "replyTarget": {
          "type": "string",
          "enum": [
            "parent_author",
            "group",
            "self",
            "unknown"
          ]
        },
        "languageHint": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,8}(-[a-z0-9]{1,8})*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "content",
    "categories"
  ],
  "additionalProperties": false
}
